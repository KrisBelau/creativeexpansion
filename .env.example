# Copy to .env for local development: cp .env.example .env
# Then: npm run dev   (loads .env; `npm start` ignores it, which is what Render wants)
#
# On Render set these in the dashboard under Environment, or let render.yaml do it.
# Never commit a real .env — it is gitignored.

# ---------------------------------------------------------------- networking
# Render injects PORT and the server reads it. Only set this locally.
PORT=3000

# ---------------------------------------------------------------- access
# HTTP basic auth. Any username, this password.
# Leave empty locally; ALWAYS set it on a public deployment — the app accepts
# arbitrary image uploads and runs analysis on them, so an open URL is a free
# CPU faucet for anyone who finds it.
ACCESS_PASSWORD=

# ---------------------------------------------------------------- memory
# Sources, rendered buffers and batches are all held in process memory (there is
# no database yet — see SPEC section 13). These ceilings are what keep a small
# instance alive, so raise them only alongside the instance size.
#
# Reference: a 40-placement batch on a 1080x1080 master peaks around 100-150 MB
# of pixel buffers. Doubling the master's dimensions roughly quadruples that.

# Upload ceiling per file. A 512 MB instance cannot survive a 500 MB upload.
MAX_UPLOAD_MB=24

# Analysed masters retained before the oldest is evicted.
MAX_SOURCES=4

# Rendered batches retained. Each one holds every output buffer it produced.
MAX_BATCHES=3

# Rejected up front with a clear error rather than dying mid-render.
# 74 is every image placement in the catalog; 60 is safe on 512 MB.
MAX_PLACEMENTS_PER_BATCH=60
